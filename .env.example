# 실제 환경값은 로컬 .env.local 또는 Vercel 환경 설정에서 관리합니다.
# NEXT_PUBLIC_*에는 인증 토큰·서버 비밀을 넣지 않습니다.

# 검색엔진 소유 확인 코드 (없으면 meta 태그가 렌더링되지 않음)
# Google Search Console → 설정 → 소유권 확인 → HTML 태그 방식의 content 값
GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 → 사이트 관리 → 소유확인 → HTML 태그 방식의 content 값
NAVER_SITE_VERIFICATION=

# GA4 웹 데이터 스트림의 Measurement ID (Vercel Production에만 설정)
# VERCEL_ENV=production에서만 활성화. 방문자가 분석에 동의한 뒤 로드됩니다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 서버 설정: ga4,vercel (기본), ga4, vercel 또는 none
ANALYTICS_PROVIDERS=ga4,vercel
# Vercel Observability 공개 SDK 설정/base path는 플랫폼 제공 값을 유지합니다.
# NEXT_PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG=
# NEXT_PUBLIC_VERCEL_OBSERVABILITY_BASEPATH=
